# ============================================
# SETHIZZZ ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in values
# ============================================

# --- FIREBASE (get from Firebase Console → Project Settings → Your apps) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- RAZORPAY (get from Razorpay Dashboard → Settings → API Keys) ---
# Use test keys first (rzp_test_...), swap to live when ready
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# --- ADMIN BOOTSTRAP ---
# Email of the very first admin. Used by the seeder to create the admin doc.
VITE_BOOTSTRAP_ADMIN_EMAIL=you@sethizzz.com

# --- OPTIONAL: WhatsApp Cloud API (for order notifications, phase 2) ---
# VITE_WHATSAPP_PHONE_ID=
# VITE_WHATSAPP_TOKEN=

# --- OPTIONAL: India Post pincode API ---
# The frontend uses https://api.postalpincode.in/pincode/{code} by default (free, no key)
